---
// src/pages/[...locale]/contact.astro - contact : un formulaire de demonstration complet, l'adresse directe, et ce qui se passe ensuite.
//
// Build statique, le formulaire (Sections/Contact/ContactForm.astro) est ECRIT
// mais NON MONTE : il n'a pas d'attribut action, il n'envoie rien, et c'est un
// choix. Le theme est 100% statique et sans adapter ; choisir un prestataire
// d'envoi a la place de l'utilisateur l'obligerait a le desinstaller avant
// d'installer le sien. Tout le reste est pret : le balisage, les libelles
// traduits, le cablage d'accessibilite. Moteur allume, il poste vers
// l'extension Courriels du back office quand elle est reglee, ou vers le
// service externe saisi dans l'entree "site" (voir le composant).
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import ContactForm from "@components/Sections/Contact/ContactForm.astro";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getLocale, localePaths, localizePath } from "@i18n";
import { breadcrumbList } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import { annotationsDe } from "@moteur/annotations";
import { lienDe, imageDePartage } from "@moteur/cadre";
import Pastilles from "@moteur/Pastilles.astro";
import { identiteDuSite } from "@moteur/theme";
import { propsDeLaPage } from "@moteur/chemins";
import { textesDeLaPage } from "@moteur/textes";

export const getStaticPaths = localePaths;

// Moteur allume, cette page se rend a la demande (ses textes viennent de la
// base) : une langue inconnue repond 404, comme au build.
const demande = await propsDeLaPage(Astro, getStaticPaths);
if (demande instanceof Response) return demande;

const locale = getLocale(Astro);
// Les textes rediges de la page : ceux de la base moteur allume (docs/moteur.md),
// poses sur la requete pour ses composants.
const t = await textesDeLaPage(Astro);
const direct = annotationsDe(Astro, "contact-direct");
const suite = annotationsDe(Astro, "contact-suite");
// L'adresse e-mail du site (entree "site", sinon siteData) ; le bouton du bloc
// "contact-direct" peut aussi mener ailleurs (champ cta_link).
const marque = identiteDuSite(Astro, locale);
const lienDirect = lienDe(Astro, "contact-direct", "cta_link") ?? `mailto:${marque.email}`;

const title = t.contact.metaTitle;
const description = t.contact.metaDescription;

const base = Astro.site ?? Astro.url;
const crumbs = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.contact.crumb, url: new URL(localizePath("/contact/", locale), base).href },
]);
---

<BaseLayout {title} {description} image={imageDePartage(Astro, "contact")}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <Navbar />

  <main id="content">
    <PageHero
      cle="contact"
      edition={annotationsDe(Astro, "contact")}
      eyebrow={t.contact.eyebrow}
      title={t.contact.title}
      accentWord={t.contact.accent}
      lede={t.contact.lede}
      crumbs={[{ label: t.contact.crumb }]}
    />

    <div class="container-page grid gap-10 py-14 md:py-20 lg:grid-cols-12 lg:gap-14">
      <ContactForm />

      <div class="flex flex-col gap-6 lg:col-span-5">
        <section
          class="border-border bg-surface rounded-card flex flex-col gap-3 border p-7"
          aria-labelledby="direct-title"
          {...direct.entree}
        >
          <Pastilles cle="contact-direct" liens={[["cta_link", `mailto:${marque.email}`]]} enLigne />
          <span class="text-primary" aria-hidden="true"><Icon name="mail" size={22} /></span>
          <h2
            id="direct-title"
            class="font-display text-foreground text-xl font-semibold tracking-tight"
            {...direct.champ("title")}
          >
            {t.contact.directTitle}
          </h2>
          <p class="text-muted-foreground text-[0.95rem] leading-relaxed" {...direct.champ("lede")}>{t.contact.directLede}</p>
          <Button
            href={lienDirect}
            variant="outline"
            size="md"
            class="mt-2 self-start"
            {...direct.champ("cta")}
          >
            {t.contact.directCta}
          </Button>
        </section>

        <section
          class="border-border rounded-card flex flex-col gap-4 border p-7"
          aria-labelledby="next-title"
          {...suite.entree}
        >
          <h2
            id="next-title"
            class="font-display text-foreground text-xl font-semibold tracking-tight"
            {...suite.champ("title")}
          >
            {t.contact.nextTitle}
          </h2>
          <ol class="flex flex-col gap-4" {...suite.champ("arguments")}>
            {
              t.contact.nextSteps.map((step, index) => (
                <li class="flex items-start gap-3">
                  <span
                    class="bg-primary/12 text-primary font-display rounded-pill mt-0.5 grid size-6 shrink-0 place-items-center text-xs font-semibold"
                    aria-hidden="true"
                  >
                    {index + 1}
                  </span>
                  <span class="text-muted-foreground text-[0.95rem] leading-relaxed">{step}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

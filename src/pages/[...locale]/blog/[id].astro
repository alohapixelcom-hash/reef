---
// src/pages/[...locale]/blog/[id].astro - la route d'un billet : une par billet ET par langue.
//
// Les id de collection sont prefixes ("fr/mon-billet") parce que le contenu est
// range par langue ; l'URL, elle, ne porte que le slug, le prefixe etant deja
// dans le param locale. C'est ce qui permet au selecteur de langue d'emmener le
// lecteur sur LA traduction du billet qu'il lit, et pas sur l'accueil.
//
// Le rendu vit dans ArticlePage. Cette route ne fait qu'aiguiller, parce que,
// moteur allume, /blog/2/ arrive ICI avant la route d'archive (un parametre
// nomme passe avant un parametre de reste) : un numero de page rend l'archive.
import ArchivePage from "@components/Pages/ArchivePage.astro";
import ArticlePage from "@components/Pages/ArticlePage.astro";
import { defaultLocale, locales } from "@i18n";
import { entryLocale, entrySlug } from "@i18n/content";
import { cheminsArchive, type PropsArchive } from "@js/archive";
import { introuvable, propsDeLaPage } from "@moteur/chemins";
import { billetsPublies, MOTEUR } from "@moteur/source";
import { getEntry, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  // Les brouillons se previsualisent dans l'editeur prive, jamais a une URL publique.
  // Fichiers ou base : la source ne rend que les billets publies.
  const posts = (await Promise.all(locales.map((locale) => billetsPublies(locale)))).flat();

  return Promise.all(
    posts.map(async (post) => {
      // Une reference cassee arrete le build avec le nom du fichier fautif,
      // plutot que de rendre une page a moitie vide en production.
      const author = await getEntry(post.data.author);
      if (!author) throw new Error(`Auteur inconnu "${post.data.author.id}" dans "${post.id}"`);
      const topic = await getEntry(post.data.topic);
      if (!topic) throw new Error(`Sujet inconnu "${post.data.topic.id}" dans "${post.id}"`);

      const locale = entryLocale(post.id);
      return {
        params: {
          // undefined genere la route sans prefixe : l'anglais est servi a la
          // racine, les autres langues sous leur code.
          locale: locale === defaultLocale ? undefined : locale,
          id: entrySlug(post.id),
        },
        props: { post, author, topic },
      };
    }),
  );
}

type Props = {
  post: CollectionEntry<"posts">;
  author: CollectionEntry<"authors">;
  topic: CollectionEntry<"topics">;
};

const numero = MOTEUR && /^\d+$/.test(Astro.params.id ?? "");
const archive = numero
  ? await propsDeLaPage<PropsArchive>(
      { params: { locale: Astro.params.locale, page: Astro.params.id }, props: {} },
      cheminsArchive,
    )
  : undefined;
const billet = numero ? undefined : await propsDeLaPage<Props>(Astro, getStaticPaths);
if (!archive && !billet) return introuvable();
---

{archive ? <ArchivePage {...archive} /> : billet && <ArticlePage {...billet} />}

---
// src/pages/[...locale]/page-libre.astro - moteur allume : une page libre du back office (collection "pages"), servie a son adresse par la page d'accueil, qui la reecrit ici.
//
// POURQUOI UNE ROUTE A PART. La page d'accueil ([...locale]/index.astro)
// attrape toute adresse a un segment ; quand ce n'est pas l'une des siennes et
// que l'adresse peut etre celle d'une page libre, elle la reecrit ici
// (Astro.rewrite). Rendue dans la page d'accueil elle-meme, la page libre
// ajoutait a l'accueil les feuilles de style du texte riche d'EmDash : le HTML anonyme de l'accueil ne doit pas bouger.
// Demandee directement (/page-libre/), l'adresse repond 404.
//
// Moteur eteint : aucune sortie, aucune page libre n'existe.
import { MOTEUR } from "@moteur/source";
import PageLibre from "@moteur/PageLibre.astro";
import { pageLibreDeLAdresse } from "@moteur/pages";
import { textesDeLaPage } from "@moteur/textes";

export function getStaticPaths() {
  return [];
}

const origine = Astro.originPathname;
const libre = MOTEUR && origine !== Astro.url.pathname ? await pageLibreDeLAdresse({ params: { locale: origine.replace(/^\/+|\/+$/g, "") } }) : null;
if (!libre) return new Response(null, { status: 404 });
await textesDeLaPage(Astro, libre.locale);
---

<PageLibre page={libre} />

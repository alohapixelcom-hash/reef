---
// src/pages/[...locale]/legal.astro - les mentions legales : qui publie, qui heberge, et comment signaler un probleme.
//
// Ce document porte SA copie dans le dictionnaire (t.legal) et non dans
// src/config/legalData.json.ts, qui ne couvre que la confidentialite et les
// conditions. Les passages entre crochets sont a completer par l'utilisateur, et
// ce texte ne vaut pas un avis juridique.
import LegalArticle from "@components/Sections/Legal/LegalArticle.astro";
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import { getLocale, localePaths, localizePath } from "@i18n";
import { breadcrumbList } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import { annotationsDe } from "@moteur/annotations";
import { argumentDe, imageDePartage } from "@moteur/cadre";
import { propsDeLaPage } from "@moteur/chemins";
import { textesDeLaPage } from "@moteur/textes";

export const getStaticPaths = localePaths;

// Moteur allume, cette page se rend a la demande (ses textes viennent de la
// base) : une langue inconnue repond 404, comme au build.
const demande = await propsDeLaPage(Astro, getStaticPaths);
if (demande instanceof Response) return demande;

// La date de revision des mentions legales vit ici : contrairement a la
// confidentialite et aux conditions, ce document n'a pas d'entree dans
// src/config/legalData.json.ts. C'est la ligne a changer le jour ou le texte
// change, et la seule.
const locale = getLocale(Astro);
// Les textes rediges de la page : ceux de la base moteur allume (docs/moteur.md),
// poses sur la requete pour ses composants.
const t = await textesDeLaPage(Astro);

const mentions = annotationsDe(Astro, "mentions-legales");
// L'ancre de chaque clause : celle que l'editeur a donnee (sous-champ
// "anchor"), sinon celle que le titre donne, comme avant.
const ancres = t.legal.sections.map((_, rang) => argumentDe(Astro, "mentions-legales", rang).anchor as string | undefined);
const title = t.legal.title;
const description = t.legal.description;

const base = Astro.site ?? Astro.url;
const crumbs = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.legal.crumb, url: new URL(localizePath("/legal/", locale), base).href },
]);
---

<BaseLayout {title} {description} image={imageDePartage(Astro, "mentions-legales")}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <Navbar />

  <main id="content">
    <PageHero
      cle="mentions-legales"
      edition={mentions}
      eyebrow={t.legal.eyebrow}
      title={t.legal.title}
      lede={t.legal.description}
      crumbs={[{ label: t.legal.crumb }]}
    />

    <LegalArticle
      sections={t.legal.sections}
      updated={t.legal.updated}
      updatedTemplate={t.legal.lastUpdated}
      tocLabel={t.legal.toc}
      backToTopLabel={t.legal.backToTop}
      annotationDeLaDate={mentions.champ("revised")}
      annotationDesClauses={mentions.champ("arguments")}
      {ancres}
      {locale}
    />
  </main>

  <Footer />
</BaseLayout>

---
// src/pages/[...locale]/topics/[topic]/[...page].astro - l'archive d'un sujet, paginee par neuf.
//
// Une entree par langue ET par sujet. Le segment d'URL passe par entrySlug :
// l'id de collection vaut "en/typography", et l'ecrire tel quel donnerait
// /topics/en/typography/, une URL que personne n'a demandee.
import PostGrid from "@components/Sections/Archive/PostGrid.astro";
import TopicNav from "@components/Sections/Archive/TopicNav.astro";
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import { fmt, getLocale, localizePath } from "@i18n";
import { entrySlug } from "@i18n/content";
import { cheminsDuSujet } from "@js/adresses";
import { breadcrumbList } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import { annotationsDe } from "@moteur/annotations";
import { annotationsDeLaFiche, type PanneauSeo, seoDe } from "@moteur/listes";
import { propsDeLaPage } from "@moteur/chemins";
import { textesDeLaPage } from "@moteur/textes";
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import type { ResolvedPost } from "@js/posts";

export const getStaticPaths = cheminsDuSujet;

type Props = {
  page: Page<ResolvedPost>;
  topic: CollectionEntry<"topics">;
  topics: CollectionEntry<"topics">[];
};

const props = await propsDeLaPage<Props>(Astro, getStaticPaths);
if (props instanceof Response) return props;
const { page, topic, topics } = props;
const locale = getLocale(Astro);
// Les textes rediges de la page : ceux de la base moteur allume (docs/moteur.md),
// poses sur la requete pour ses composants.
const t = await textesDeLaPage(Astro);
// Moteur allume, en mode edition : la fiche du sujet (collection "sujets")
// porte l'entree de la page, son nom (le mot en couleur du titre, et le fil
// d'Ariane) et sa description ; l'entree "sujet" porte le surtitre et le
// modele du titre ({topic} y devient le nom), ouvert au back office.
const fiche = annotationsDeLaFiche(topic);
const modele = annotationsDe(Astro, "sujet");
const CHAMPS: Record<string, () => Record<string, string>> = {
  eyebrow: () => modele.champ("eyebrow"),
  title: () => modele.champ("body"),
  accent: () => fiche.champ("name"),
  lede: () => fiche.champ("description"),
};
const edition = { entree: fiche.entree, champ: (nom: string) => CHAMPS[nom]?.() ?? {} };

const slug = entrySlug(topic.id);
const heading = fmt(t.archive.topicTitle, { topic: topic.data.name });
const title =
  page.currentPage > 1
    ? `${heading}, ${fmt(t.archive.pageSuffix, { n: page.currentPage })}`
    : heading;
// Le panneau SEO du sujet passe avant ses champs ; son image, avant celle du site.
const seo = seoDe((topic as unknown as { seo?: PanneauSeo }).seo, { title, description: topic.data.description });
const photo = (topic as unknown as { image?: { src: string } }).image;
const image = seo.image ?? photo?.src;

const base = Astro.site ?? Astro.url;
const crumbs = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.topics.crumb, url: new URL(localizePath("/topics/", locale), base).href },
  { name: topic.data.name, url: new URL(localizePath(`/topics/${slug}/`, locale), base).href },
]);

const noindex = page.currentPage > 1 || seo.noindex;
---

<BaseLayout title={seo.title} description={seo.description} {noindex} image={image ? { src: image, alt: topic.data.name } : undefined} canonical={seo.canonical}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <Navbar />

  <main id="content">
    <PageHero
      edition={edition}
      eyebrow={t.topics.pageEyebrow}
      title={heading}
      accentWord={topic.data.name}
      lede={topic.data.description}
      crumbs={[
        { label: t.topics.crumb, href: localizePath("/topics/", locale), attributs: annotationsDe(Astro, "rubriques").champ("breadcrumb") },
        { label: topic.data.name, attributs: fiche.champ("name") },
      ]}
    >
      <TopicNav {topics} {locale} activeSlug={slug} class="mt-2" />
    </PageHero>

    <PostGrid
      posts={page.data}
      {locale}
      basePath={localizePath(`/topics/${slug}`, locale)}
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      total={page.total}
      headingLevel="h2"
      emptyTitle={t.topics.emptyTitle}
      emptyDescription={t.topics.emptyLede}
      emptyCtaLabel={t.archive.emptyCta}
      emptyCtaHref={localizePath("/blog/", locale)}
    />
  </main>

  <Footer />
</BaseLayout>

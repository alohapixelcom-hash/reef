---
// src/pages/[...locale]/terms.astro - les conditions d'utilisation, servies depuis src/config/legalData.json.ts.
//
// getSiteRoutes declare /terms/ : la route existe donc pour de bon, meme si le
// pied de page ne l'affiche pas (il ne montre que les mentions legales et la
// confidentialite, les deux documents qu'un lecteur de blog consulte). Meme
// gabarit que les deux autres documents.
import LegalArticle from "@components/Sections/Legal/LegalArticle.astro";
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import { getLocale, localePaths, localizePath } from "@i18n";
import { breadcrumbList } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import { annotationsDe } from "@moteur/annotations";
import { argumentDe, imageDePartage } from "@moteur/cadre";
import { propsDeLaPage } from "@moteur/chemins";
import { textesDeLaPage } from "@moteur/textes";

export const getStaticPaths = localePaths;

// Moteur allume, cette page se rend a la demande (ses textes viennent de la
// base) : une langue inconnue repond 404, comme au build.
const demande = await propsDeLaPage(Astro, getStaticPaths);
if (demande instanceof Response) return demande;

const locale = getLocale(Astro);
// Les textes rediges de la page : ceux de la base moteur allume (docs/moteur.md),
// poses sur la requete pour ses composants.
const t = await textesDeLaPage(Astro);
const doc = t.legalData.terms;
const ed = annotationsDe(Astro, "conditions");
// L'ancre de chaque clause : celle que l'editeur a donnee, sinon celle du titre.
const ancres = doc.sections.map((_, rang) => argumentDe(Astro, "conditions", rang).anchor as string | undefined);

const base = Astro.site ?? Astro.url;
const crumbs = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.legal.termsCrumb, url: new URL(localizePath("/terms/", locale), base).href },
]);
---

<BaseLayout title={doc.title} description={doc.description} image={imageDePartage(Astro, "conditions")}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <Navbar />

  <main id="content">
    <PageHero
      cle="conditions"
      edition={ed}
      eyebrow={t.legal.termsEyebrow}
      title={doc.title}
      lede={doc.description}
      crumbs={[{ label: t.legal.termsCrumb }]}
    />

    <LegalArticle
      sections={doc.sections}
      updated={doc.lastUpdated}
      updatedTemplate={t.legal.lastUpdated}
      tocLabel={t.legal.toc}
      backToTopLabel={t.legal.backToTop}
      annotationDeLaDate={ed.champ("revised")}
      annotationDesClauses={ed.champ("arguments")}
      {ancres}
      {locale}
    />
  </main>

  <Footer />
</BaseLayout>

---
// src/pages/[...locale]/authors/index.astro - l'index des signatures : qui ecrit ici, et combien chacun a publie.
import AuthorCard from "@components/Cards/AuthorCard.astro";
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, localePaths, localizePath } from "@i18n";
import { entrySlug } from "@i18n/content";
import { getResolvedPosts, getSortedAuthors } from "@js/posts";
import { breadcrumbList } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import { imageDePartage } from "@moteur/cadre";
import { annotationsDe } from "@moteur/annotations";
import { propsDeLaPage } from "@moteur/chemins";
import { textesDeLaPage } from "@moteur/textes";

export const getStaticPaths = localePaths;

// Moteur allume, cette page se rend a la demande et [...locale] accepte
// n'importe quel segment : une langue inconnue repond 404, comme au build.
const demande = await propsDeLaPage(Astro, getStaticPaths);
if (demande instanceof Response) return demande;

const locale = getLocale(Astro);
// Les textes rediges de la page : ceux de la base moteur allume (docs/moteur.md),
// poses sur la requete pour ses composants.
const t = await textesDeLaPage(Astro);
const routes = getSiteRoutes(locale);

const authors = await getSortedAuthors(locale);
const posts = await getResolvedPosts(locale);

const counts: Record<string, number> = {};
for (const entry of posts) counts[entry.authorSlug] = (counts[entry.authorSlug] ?? 0) + 1;

const title = t.authors.metaTitle;
const description = t.authors.metaDescription;

const base = Astro.site ?? Astro.url;
const crumbs = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.authors.crumb, url: new URL(localizePath("/authors/", locale), base).href },
]);
---

<BaseLayout {title} {description} image={imageDePartage(Astro, "auteurs")}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <Navbar />

  <main id="content">
    <PageHero
      cle="auteurs"
      edition={annotationsDe(Astro, "auteurs")}
      eyebrow={t.authors.eyebrow}
      title={t.authors.title}
      accentWord={t.authors.accent}
      lede={t.authors.lede}
      crumbs={[{ label: t.authors.crumb }]}
    />

    <section class="container-page py-14 md:py-20" aria-label={t.authors.metaTitle}>
      <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          authors.map((author) => {
            const slug = entrySlug(author.id);
            return (
              <li class="flex">
                <AuthorCard
                  {author}
                  {locale}
                  href={`${routes.authors}${slug}/`}
                  count={counts[slug] ?? 0}
                  as="h2"
                  showLinks
                  class="w-full"
                />
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>

  <Footer />
</BaseLayout>

---
// src/layouts/AdminLayout.astro - coquille du back office interne Aloha, adaptee aux langues Reef.
import AdminShell from "@components/Sections/BackOffice/AdminShell.astro";
import BaseLayout from "./BaseLayout.astro";
import siteData from "@config/siteData.json";
import { getLocale, localizePath } from "@i18n";
import { backofficeCopy } from "@i18n/backoffice";
interface Props { title: string; login?: boolean }
const { title, login = false } = Astro.props;
const demo = process.env.ALOHA_BACKOFFICE !== "1";
const locale = getLocale(Astro);
const t = backofficeCopy[locale];
---
<BaseLayout {title} noindex>
  <AdminShell compact brand={siteData.name} home={localizePath("/", locale)} space={t.space} {title} {login} accentWord={title.split(" ")[0]}
    navigation={[{ href: localizePath("/secret-spot/", locale), label: t.articles, icon: "file-text" }, { href: localizePath("/secret-spot/rubriques/", locale), label: t.categories, icon: "folder" }]}
    logout={demo ? "" : t.logout} logoutUrl={localizePath("/secret-spot/connexion/", locale)} back={t.back} connected={t.connected}>
    <slot />
  </AdminShell>
  <script>
    const init = () => {
      const button = document.querySelector<HTMLButtonElement>("[data-admin-logout]");
      if (!button || button.dataset.ready) return;
      button.dataset.ready = "1";
      void fetch("/api/auth/me", { cache: "no-store" }).then(r => r.json()).then((user: { email?: string }) => {
        const label = document.querySelector("[data-session-email]");
        if (label) label.textContent = user.email ?? "";
      }).catch(() => undefined);
      button.addEventListener("click", async () => {
        button.disabled = true;
        try { const response = await fetch("/api/auth/logout", { method: "POST" }); if (response.ok) location.href = button.dataset.adminLogout!; }
        finally { button.disabled = false; }
      });
    };
    init(); document.addEventListener("astro:page-load", init);
  </script>
</BaseLayout>

---
// src/components/Sections/Global/PhoneShot.astro - le telephone dessine qui montre le premier ecran du site sur mobile.
//
// Le cadre est DESSINE, pas photographie : c'est le telephone de la maison
// (src/components/ui/appareil/Telephone.astro), aluminium et verre en CSS,
// aucune image d'habillage a charger ni a licencier, aucune marque.
//
// Il n'a pas d'encoche, et c'est voulu : elle mangeait le haut de l'ecran,
// c'est-a-dire exactement ce que ce bloc essaie de montrer. Le cadre et le
// rapport 9/19,5 suffisent a le faire lire comme un telephone.
//
// Ce qui est dedans est une CAPTURE, pas un iframe. Un cadre qui recharge le
// site dans le site double le poids de la page, rejoue ses animations et
// double ses requetes ; l'image pese quarante kilo-octets et ne bouge pas.
//
// La contrepartie est qu'une capture vieillit. `pnpm poster` la refabrique
// depuis dist/, et c'est la commande a lancer apres `pnpm rebrand`, apres un
// changement de texte d'accueil ou apres un redessin du premier ecran. Sans
// elle, le telephone montrerait la demonstration d'origine dans un site
// devenu celui de son acheteur.
//
// Le composant ne pose AUCUNE classe d'affichage. C'est a l'appelant d'ecrire
// `hidden lg:block` s'il ne veut le cadre que sur grand ecran : une classe
// d'affichage cuite dans une chaine partagee est le piege connu de la maison,
// Tailwind emettant `.block` apres `.hidden`.
//
// La largeur se regle par la variable `--phone-width`, jamais par une classe
// `max-w-*`, et ce n'est pas une preference. Astro porte les styles scopes sur
// un attribut, donc `.phone[data-astro-cid-...]` compte deux selecteurs quand
// une utilitaire Tailwind n'en compte qu'un : un `max-w-[13rem]` pose par
// l'appelant perdrait en silence contre le `max-width` d'ici. Un bouton de
// reglage passe par la cascade des variables, ou l'appelant a le dernier mot :
//
//   <PhoneShot class="hidden [--phone-width:13rem] lg:block" />

import { Telephone } from "@components/ui/appareil";
import type { Media } from "@moteur/cadre";

interface Props {
  /** Classes posees sur le cadre, pour le caler et decider ou il apparait. */
  class?: string;
  /** Moteur allume : la capture choisie dans le back office (champ image de la section qui porte le telephone). Absente, celle de `pnpm poster`. */
  capture?: Media | null;
  /** L'annotation de la barre d'edition (ce champ image), absente hors edition. */
  annotation?: string;
}

const { class: className, capture = null, annotation } = Astro.props;

// La capture vit dans public/ : servie par le meme domaine que la page, donc
// aucune requete vers un tiers et aucune licence a produire, puisqu'il s'agit
// du site lui-meme.
const SHOT = "reef-iphone-poster.webp";

// Si la capture n'a pas encore ete fabriquee, le bloc ne rend RIEN. Un cadre de
// telephone vide, ou pire une image cassee, est un defaut visible; une absence
// ne l'est pas. Le controle a lieu AU BUILD, dans astro.config.mjs, qui fige
// le resultat dans __REEF_CAPTURE_DU_TELEPHONE__ : il ne coute rien au
// visiteur, et il rend `pnpm poster` facultatif au lieu d'obligatoire. Il ne
// se fait plus au rendu avec existsSync : moteur allume, la page se rend a la
// demande dans un Worker, qui n'a pas le disque du depot (le telephone
// disparaissait de la page A propos ; regle 7 de house.mjs).
// Une capture choisie dans le back office passe avant celle de `pnpm poster`.
const hasShot = capture !== null || __REEF_CAPTURE_DU_TELEPHONE__;
---

{/* Decoratif au sens strict : ce que le telephone montre est la page ou se
    trouve deja le visiteur, donc alt vide et aria-hidden. Un lecteur d'ecran
    qui annoncerait ce cadre ferait lire deux fois le meme site. */}
{
  hasShot && (
    <Telephone class:list={["phone", className]}>
      <img
        src={capture?.src ?? `/${SHOT}`}
        alt=""
        width={capture?.width ?? "560"}
        height={capture?.height ?? "1213"}
        loading="lazy"
        decoding="async"
        data-emdash-ref={annotation}
      />
    </Telephone>
  )
}

<style>
  /* Le dessin est dans ui/appareil/Telephone.astro, le meme fichier que sur
     alohapixel.com, alohapixel.app et dans les visuels du catalogue : un
     appareil generique, sans encoche, ilot ni logo. Ce composant ne fait que
     poser la capture et borner la largeur. */
  .phone {
    width: 100%;
    max-width: var(--phone-width, 17rem);
    margin-inline: auto;
  }
</style>

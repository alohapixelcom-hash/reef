---
// src/components/Sections/Home/Hero.astro - le premier ecran : une vague en pleine page, une colonne de texte a gauche, la pile des dernieres notes a droite.
//
// Ce que ce hero corrige
// ----------------------
// La version precedente etait une page de texte : un titre, un chapeau, deux
// boutons, et a droite une liste de trois titres alignes sur un filet. Tout y
// etait juste et rien n'y etait une image. Un lecteur qui arrive decide en une
// seconde, et une seconde ne suffit pas a lire trois titres : elle suffit a
// reconnaitre une forme.
//
// La forme, ici, c'est une photographie, et par dessus une pile de fiches en
// perspective. La pile seule ne suffisait pas : un ecran entierement fabrique
// avec du texte compose et des degrades se reconnait, et se fait reprocher.
// La photographie apporte ce qu'aucun degrade ne sait produire, une lumiere
// qui n'est pas calculee. Et le sujet n'est pas decoratif : le logo de la
// maison EST une vague, le mot d'accent des titres est souligne d'une vague.
// Le premier ecran dit donc la meme chose que la marque.
//
// La scene reste sombre dans les deux themes (.deep-scene, voir global.css).
// Un cadre qui blanchit en mode clair perd ses halos et ses lueurs de bordure :
// il perd donc l'image, et le premier ecran redevient une page de texte.
import heroVague from "../../../assets/reef-hero-vague.webp";
import { topicTone, type TopicAccent } from "@components/Cards/topicTone";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { fmt, getLocale, useTranslations } from "@i18n";
import { Image } from "astro:assets";

interface RecentEntry {
  href: string;
  title: string;
  /** Date deja mise en forme dans la langue de la page. */
  date: string;
  /** La meme date en ISO, pour l'attribut datetime. */
  iso: string;
  /** Nom du sujet, deja traduit par la page. */
  topic: string;
  /** L'accent declare par le sujet, traduit en tokens par topicTone. */
  accent: TopicAccent;
  minutes: number;
}

interface Props {
  /** Les trois dernieres notes. La page les fournit, le hero ne les cherche pas. */
  recent?: RecentEntry[];
  /** Trois nombres qui disent combien il y a a lire : notes, sujets, langues. */
  ledger?: readonly number[];
}

const { recent = [], ledger = [] } = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

// Decoupe du titre autour du mot accentue, insensible a la casse.
const title = t.home.heroTitle;
const accent = t.home.heroAccent;
const at = title.toLowerCase().indexOf(accent.toLowerCase());
const before = at >= 0 ? title.slice(0, at) : title;
const word = at >= 0 ? title.slice(at, at + accent.length) : "";
const after = at >= 0 ? title.slice(at + accent.length) : "";

// La pile se lit du fond vers l'avant : la note la plus ancienne est la plus
// haute et la plus enfoncee, la plus recente est devant et entiere. On inverse
// donc l'ordre a l'affichage, pas dans les donnees.
//
// L'opacite des fiches du fond ne descend pas plus bas que 0.84, et c'est une
// contrainte de lisibilite et non de gout : en dessous, la date et le sujet
// passaient sous le rapport de contraste de 4.5 alors qu'ils restent sur de
// vrais liens.
const deck = [...recent].slice(0, 3).reverse();
const depth = [
  { z: "-110px", x: "2.2rem", o: "0.84" },
  { z: "-55px", x: "1.1rem", o: "0.93" },
  { z: "0px", x: "0rem", o: "1" },
];
---

{/* Le fond de page sur lequel la scene est posee. C'est lui qui fait exister le
    cadre : sans marge autour, le coin arrondi n'aurait rien contre quoi se
    detacher, et la scene redeviendrait un bandeau pleine largeur. */}
<div class="bg-background p-2 sm:p-3 md:p-4" data-slot="home-hero">
  <section
    class="deep-scene rounded-panel relative isolate overflow-hidden"
    aria-labelledby="hero-title"
    data-deep-scene
  >
    {/* La photographie, tout au fond. Elle est decorative au sens strict : le
        titre dit deja de quoi parle le site, donc un alt vide evite de faire
        lire deux fois la meme chose a un lecteur d'ecran.
        loading="eager" et fetchpriority="high" parce que c'est le premier
        ecran : la charger paresseusement, c'est afficher un trou noir pendant
        que le reste s'installe. Les dimensions viennent de l'import, donc
        aucun decalage de mise en page au chargement.
        Le cadrage tire vers le bas : la ou la vague se creuse. Centre, on ne
        voyait que du ciel. */}
    <Image
      src={heroVague}
      alt=""
      widths={[720, 1200, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="pointer-events-none absolute inset-0 size-full object-cover object-[center_62%]"
      aria-hidden="true"
    />

    {/* Voile de lecture, en deux couches et pas une.
        Reglage trouve en trois essais, et les deux ratages valent d'etre notes
        parce qu'ils bornent le probleme : a 90 pour cent de noir sur toute la
        largeur, la photo devenait invisible ; a 70 pour cent qui mouraient
        avant le milieu, le chapeau et les compteurs passaient sous le rapport
        de contraste des que l'ecume passait dessous. Le voile doit donc couvrir
        TOUTE la colonne de texte, qui va jusqu'a 55 pour cent de la largeur sur
        grand ecran, puis s'ouvrir franchement pour laisser la vague entiere.
        Le noir est ici un canal alpha, pas une couleur : il n'a donc pas de
        token, et il n'en veut pas. */}
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/88 from-0% via-black/60 via-42% to-transparent to-80%"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/30"
      aria-hidden="true"
    >
    </div>

    {/* Les deux halos existaient pour donner un centre a un fond vide. Le fond
        n'est plus vide : la photo a sa propre lumiere, et deux nappes floues
        par dessus la salissent au lieu de la servir. Ils restent, tres bas, et
        seulement pour rechauffer les bords ou la photo s'assombrit. */}
    <div
      class="animate-drift pointer-events-none absolute -top-2/5 -right-1/4 size-[42rem] rounded-full opacity-12 blur-3xl"
      style="background: radial-gradient(circle, var(--color-coral-500) 0%, transparent 68%)"
      aria-hidden="true"
    >
    </div>
    <div
      class="animate-drift-slow pointer-events-none absolute -bottom-1/4 -left-1/5 size-[38rem] rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(circle, var(--color-reef-500) 0%, transparent 70%)"
      aria-hidden="true"
    >
    </div>

    {/* La grille compte trois enfants et non deux : le texte, la pile, puis le
        compteur. Sur telephone ils se suivent dans cet ordre, ce qui fait
        remonter la pile juste sous les boutons. Sur grand ecran le compteur
        retrouve sa place sous le texte, et la pile occupe les deux rangees de
        la colonne de droite. */}
    <div
      class="container-page relative z-10 grid gap-10 pt-28 pb-14 sm:gap-14 sm:pt-32 md:pt-40 md:pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.92fr)] lg:grid-rows-[auto_auto] lg:gap-x-16 lg:gap-y-10 lg:pt-44 lg:pb-24"
    >
      {/* --- Colonne de gauche : ce qu'on dit ----------------------------- */}
      <div class="flex flex-col items-start lg:col-start-1 lg:row-start-1 lg:self-end">
        <p
          class="text-muted-foreground flex items-center gap-3 text-xs font-medium tracking-[0.18em] uppercase"
        >
          <span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>
          {t.home.eyebrow}
        </p>

        <h1 id="hero-title" class="font-display text-display-lg lg:text-display-xl mt-6 max-w-3xl">
          {
            word ? (
              <Fragment>
                {before}
                <span class="accent-script">{word}</span>
                {after}
              </Fragment>
            ) : (
              title
            )
          }
        </h1>

        {/* Le chapeau et les compteurs passent en blanc franc plutot qu'en
            muted : le gris de texte secondaire a ete calcule pour un aplat
            sombre, pas pour une photographie qui bouge sous lui. */}
        <p class="measure-wide mt-6 leading-relaxed text-white/85 md:text-lg lg:text-xl">
          {t.home.heroLede}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href={routes.posts} variant="primary" size="lg">
            {t.home.heroPrimary}
            <Icon name="arrow-right" size={18} />
          </Button>
          <Button href={routes.about} variant="outline" size="lg">{t.home.heroSecondary}</Button>
        </div>
      </div>

      {/* --- Colonne de droite : ce qu'on donne a lire -------------------- */}
      {
        deck.length > 0 && (
          <div
            class="relative [perspective:1500px] lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center"
            aria-label={t.home.heroRecent}
          >
            <div class="flex flex-col [transform-style:preserve-3d] lg:[transform:rotateY(-15deg)_rotateX(7deg)_rotate(-1.5deg)]">
              {deck.map((entry, i) => {
                const tone = topicTone[entry.accent];
                const front = i === deck.length - 1;
                const readLabel =
                  entry.minutes === 1 ? t.post.minReadOne : fmt(t.post.minRead, { n: entry.minutes });
                return (
                  <article
                    class:list={[
                      // bg-black/25 en plus du verre : sur un aplat sombre le
                      // verre seul suffisait, sur de l'ecume il devenait blanc
                      // sur blanc et la date disparaissait.
                      "glass rounded-card relative overflow-hidden bg-black/25 px-5 pt-5 sm:px-6 sm:pt-6",
                      front ? "pb-5 sm:pb-6" : "pb-6 lg:pb-11",
                      i > 0 && "-mt-6",
                      "lg:[transform:translateZ(var(--deck-z))_translateX(var(--deck-x))]",
                    ]}
                    style={`--deck-z: ${depth[i]?.z}; --deck-x: ${depth[i]?.x}; opacity: ${depth[i]?.o}; z-index: ${i + 1}`}
                  >
                    <span
                      class:list={["absolute inset-x-0 top-0 h-0.5", tone.rule]}
                      aria-hidden="true"
                    />
                    <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <span class:list={["rounded-pill px-2.5 py-1 text-xs font-medium", tone.chip]}>
                        {entry.topic}
                      </span>
                      <time class="text-xs text-white/70" datetime={entry.iso}>
                        {entry.date}
                      </time>
                    </p>
                    <h2
                      class:list={[
                        "font-display mt-3 leading-snug font-bold text-balance",
                        front ? "text-xl sm:text-2xl" : "line-clamp-2 text-lg",
                      ]}
                    >
                      <a
                        href={entry.href}
                        class="hover:text-primary transition-colors duration-200 after:absolute after:inset-0 after:content-['']"
                      >
                        {entry.title}
                      </a>
                    </h2>
                    {front && (
                      <p class="mt-4 flex items-center gap-2 text-xs text-white/70">
                        <Icon name="clock" size={14} />
                        {readLabel}
                      </p>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        )
      }

      {/* Trois nombres, et rien d'autre : ils repondent a la seule question
          qu'un lecteur se pose avant de cliquer, "y a-t-il de quoi lire". */}
      {
        ledger.length > 0 && (
          <dl class="flex flex-wrap gap-x-10 gap-y-4 border-t border-white/25 pt-6 lg:col-start-1 lg:row-start-2 lg:self-start">
            {t.home.heroLedger.map((label, i) => (
              <div class="flex flex-col gap-0.5">
                <dd class="font-display text-3xl leading-none font-bold md:text-4xl">
                  {ledger[i] ?? 0}
                </dd>
                <dt class="text-xs tracking-[0.14em] text-white/75 uppercase">{label}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>
</div>

---
// src/components/Sections/Home/Hero.astro - le premier ecran : une vague en pleine page, l'accroche et le titre a gauche, le chapeau et l'action a droite.
//
// Ce que ce hero corrige
// ----------------------
// La version precedente etait une page de texte : un titre, un chapeau, deux
// boutons, et a droite une liste de trois titres alignes sur un filet. Tout y
// etait juste et rien n'y etait une image. Un lecteur qui arrive decide en une
// seconde, et une seconde ne suffit pas a lire trois titres : elle suffit a
// reconnaitre une forme.
//
// La forme, ici, c'est une photographie, et rien d'autre. Elle apporte ce
// qu'aucun degrade ne sait produire, une lumiere qui n'est pas calculee. Et le
// sujet n'est pas decoratif : le logo de la maison EST une vague, le mot
// d'accent des titres est souligne d'une vague. Le premier ecran dit donc la
// meme chose que la marque.
//
// Une pile de fiches en perspective a occupe la moitie droite pendant un
// temps. Elle est partie sur un retour de terrain : voir le commentaire de la
// grille plus bas. Ne pas la reposer.
//
// La scene reste sombre dans les deux themes (.deep-scene, voir global.css).
// Un cadre qui blanchit en mode clair perd ses halos et ses lueurs de bordure :
// il perd donc l'image, et le premier ecran redevient une page de texte.
import heroVague from "../../../assets/reef-hero-vague.webp";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, useTranslations } from "@i18n";
import { Image } from "astro:assets";

interface Props {
  /** Trois nombres qui disent combien il y a a lire : notes, sujets, langues. */
  ledger?: readonly number[];
}

const { ledger = [] } = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

// Decoupe du titre autour du mot accentue, insensible a la casse.
const title = t.home.heroTitle;
const accent = t.home.heroAccent;
const at = title.toLowerCase().indexOf(accent.toLowerCase());
const before = at >= 0 ? title.slice(0, at) : title;
const word = at >= 0 ? title.slice(at, at + accent.length) : "";
const after = at >= 0 ? title.slice(at + accent.length) : "";
---

{/* Le fond de page sur lequel la scene est posee. C'est lui qui fait exister le
    cadre : sans marge autour, le coin arrondi n'aurait rien contre quoi se
    detacher, et la scene redeviendrait un bandeau pleine largeur. */}
<div class="bg-background p-2 sm:p-3 md:p-4" data-slot="home-hero">
  <section
    class="deep-scene rounded-panel relative isolate overflow-hidden"
    aria-labelledby="hero-title"
    data-deep-scene
  >
    {/* La photographie, tout au fond. Elle est decorative au sens strict : le
        titre dit deja de quoi parle le site, donc un alt vide evite de faire
        lire deux fois la meme chose a un lecteur d'ecran.
        loading="eager" et fetchpriority="high" parce que c'est le premier
        ecran : la charger paresseusement, c'est afficher un trou noir pendant
        que le reste s'installe. Les dimensions viennent de l'import, donc
        aucun decalage de mise en page au chargement.
        Le cadrage tire vers le bas : la ou la vague se creuse. Centre, on ne
        voyait que du ciel. */}
    <Image
      src={heroVague}
      alt=""
      widths={[720, 1200, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="pointer-events-none absolute inset-0 size-full object-cover object-[center_62%]"
      aria-hidden="true"
    />

    {/* Voile de lecture, en deux couches et pas une.
        Reglage trouve en trois essais, et les deux ratages valent d'etre notes
        parce qu'ils bornent le probleme : a 90 pour cent de noir sur toute la
        largeur, la photo devenait invisible ; a 70 pour cent qui mouraient
        avant le milieu, le chapeau et les compteurs passaient sous le rapport
        de contraste des que l'ecume passait dessous. Le voile doit donc couvrir
        TOUTE la colonne de texte, qui va jusqu'a 55 pour cent de la largeur sur
        grand ecran, puis s'ouvrir franchement pour laisser la vague entiere.
        Le noir est ici un canal alpha, pas une couleur : il n'a donc pas de
        token, et il n'en veut pas. */}
    <div class="hero-veil pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/30"
      aria-hidden="true"
    >
    </div>

    {/* Les deux halos existaient pour donner un centre a un fond vide. Le fond
        n'est plus vide : la photo a sa propre lumiere, et deux nappes floues
        par dessus la salissent au lieu de la servir. Ils restent, tres bas, et
        seulement pour rechauffer les bords ou la photo s'assombrit.
        Ils citaient deux entrees de palette. Ils citent maintenant l'accent et
        la couleur d'ancrage, ce qui les fait suivre le mode clair ou sombre et
        survivre a un `pnpm rebrand` sans edition. */}
    <div
      class="animate-drift pointer-events-none absolute -top-2/5 -right-1/4 size-[42rem] rounded-full opacity-12 blur-3xl"
      style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 68%)"
      aria-hidden="true"
    >
    </div>
    <div
      class="animate-drift-slow pointer-events-none absolute -bottom-1/4 -left-1/5 size-[38rem] rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%)"
      aria-hidden="true"
    >
    </div>

    {/* Le patron maison du premier ecran, le meme sur les six sites : deux
        colonnes inegales, la ligne d'accroche et le titre a gauche, le chapeau
        et les deux boutons a droite.

        La colonne de droite portait une pile de trois fiches en perspective.
        Elle est partie, et la regle qui l'a fait partir vaut pour tout ce
        qu'on serait tente d'y remettre : un objet decoratif qui ne se clique
        pas, ne se lit pas et ne dit rien du contenu occupe la moitie du
        premier ecran pour rien. Ne pas la remplacer par un autre. Ce qui
        occupe maintenant cette moitie est ce qu'on demande au lecteur de
        comprendre puis de faire, le chapeau et les deux boutons. La
        photographie porte l'image a elle seule.

        lg:items-end cale la colonne de droite sur le bas du titre : le chapeau
        et les boutons repondent alors a l'accroche au lieu de flotter a cote
        d'elle.

        min-w-0 sur les deux colonnes, sinon un mot long du titre elargit sa
        piste de grille et fait deborder la page en largeur.

        Aucun order-* : sous 1024 px les deux colonnes s'empilent dans l'ordre
        du document, qui est deja le bon - accroche, titre, chapeau, boutons,
        puis la bande des nombres qui suit la grille. */}
    {/* min-h-[80svh] et justify-center : le premier ecran doit peser quatre
        cinquiemes de la hauteur reelle, pas ce que sa marge interieure lui
        donne par hasard. svh et non vh parce que la barre d'adresse mobile
        fait varier vh en cours de defilement, et un hero qui saute pendant
        qu'on le lit est pire qu'un hero trop court. */}
    <div
      class="container-page relative z-10 flex min-h-[80svh] flex-col justify-center pt-28 pb-14 sm:pt-32 md:pt-40 md:pb-20 lg:pt-44 lg:pb-24"
    >
      <div
        class="grid w-full gap-10 sm:gap-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-end lg:gap-x-16"
      >
        {/* --- Colonne de gauche : ce qu'on dit ---------------------------- */}
        <div class="flex min-w-0 flex-col items-start">
          <p
            class="text-muted-foreground flex items-center gap-3 text-xs font-medium tracking-[0.18em] uppercase"
          >
            <span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>
            {t.home.eyebrow}
          </p>

          <h1 id="hero-title" class="font-display text-display-lg lg:text-display-xl mt-6">
            {
              word ? (
                <Fragment>
                  {before}
                  <span class="accent-script">{word}</span>
                  {after}
                </Fragment>
              ) : (
                title
              )
            }
          </h1>
        </div>

        {/* --- Colonne de droite : ce qu'on demande de faire ---------------
            Fer a gauche DANS sa colonne, jamais centre : deux blocs centres
            l'un sous l'autre n'ont plus de ligne de depart commune.

            Le chapeau passe en blanc franc plutot qu'en muted : le gris de
            texte secondaire a ete calcule pour un aplat sombre, pas pour une
            photographie qui bouge sous lui. */}
        <div class="flex min-w-0 flex-col items-start lg:justify-end lg:pb-2">
          <p class="measure-wide leading-relaxed text-white/85 md:text-lg lg:text-xl">
            {t.home.heroLede}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <Button href={routes.posts} variant="primary" size="lg">
              {t.home.heroPrimary}
              <Icon name="arrow-right" size={18} />
            </Button>
            <Button href={routes.about} variant="outline" size="lg">{t.home.heroSecondary}</Button>
          </div>
        </div>
      </div>

      {/* Les trois nombres repondent a la seule question qu'un lecteur se pose
          avant de cliquer, "y a-t-il de quoi lire". Ils restent HORS de la
          grille, pleine largeur et en bas du panneau : ranges dans une colonne
          ils deviendraient un argument de plus au lieu du socle du cadre. */}
      {
        ledger.length > 0 && (
          <dl class="mt-12 flex w-full flex-wrap gap-x-10 gap-y-4 border-t border-white/25 pt-6 md:mt-16">
            {t.home.heroLedger.map((label, i) => (
              <div class="flex flex-col gap-0.5">
                <dd class="font-display text-3xl leading-none font-bold tabular-nums md:text-4xl">
                  {ledger[i] ?? 0}
                </dd>
                <dt class="text-xs tracking-[0.14em] text-white/75 uppercase">{label}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>
</div>

<style>
  /* Le voile horizontal, ecrit ici plutot qu'en utilitaires de degrade : c'est
   * la seule facon d'en donner une seconde version sous une media query sans
   * faire dependre le resultat de l'ordre d'emission des feuilles. Les valeurs
   * sont celles d'avant, au pourcentage pres. */
  .hero-veil {
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 0.88) 0%,
      rgb(0 0 0 / 0.6) 42%,
      rgb(0 0 0 / 0) 80%
    );
  }

  /* Sous 1024 px, le voile de lecture devient VERTICAL. Le degrade horizontal
   * est dense a gauche et ouvert a droite : il suppose une colonne de texte
   * qui s'arrete avant le milieu. Sur telephone le titre et le chapeau
   * occupent toute la largeur, leurs fins de ligne tombent dans la partie
   * ouverte, et sur une photographie claire elles deviennent illisibles.
   *
   * La couleur est lue sur --reef-background, jamais sur --color-background :
   * l'alias semantique est substitue sur :root, il vaut donc la valeur CLAIRE
   * et repeindrait la vague en blanc. Dans .deep-scene, --reef-background
   * porte bien l'encre sombre de la scene. */
  @media (max-width: 63.99rem) {
    .hero-veil {
      background: linear-gradient(
        180deg,
        color-mix(in oklab, var(--reef-background) 82%, transparent) 0%,
        color-mix(in oklab, var(--reef-background) 90%, transparent) 55%,
        color-mix(in oklab, var(--reef-background) 72%, transparent) 100%
      );
    }
  }
</style>

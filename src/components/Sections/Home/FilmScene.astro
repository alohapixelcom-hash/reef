---
// src/components/Sections/Home/FilmScene.astro - la sequence filmee : une video
// que le lecteur deroule lui-meme en descendant la page.
//
// Ce que c'est, et pourquoi ce n'est pas une video de fond
// -------------------------------------------------------
// Une video de fond joue toute seule et le lecteur la regarde passer. Ici,
// c'est l'inverse : la position de lecture est branchee sur la position de
// defilement, donc c'est la MAIN du lecteur qui fait avancer l'image. Il
// s'arrete, l'image s'arrete. Il remonte, l'image remonte. C'est ce lien
// direct qui fait l'effet, et aucune animation en boucle ne le remplace.
//
// Le portage vient de la home d'alohapixel.com, ou le procede tourne en
// production. Les garde-fous ci-dessous ne sont pas theoriques : ils sont la
// parce que le cas s'est produit.
//
// 1. UNE VIDEO NE SE DEPLACE PAS INSTANTANEMENT. Demander une image que le
//    decodeur n'a pas encore, c'est une saccade. On borne donc la portion
//    jouee pour qu'il reste au moins ~1,2 pixel de defilement par image
//    (course / 36). Une video plus longue que la course disponible est
//    tronquee plutot que hachee.
//
// 2. LE DEPLACEMENT PEUT ETRE REFUSE. Certains navigateurs et certains
//    reseaux ne servent pas les plages d'octets qu'exige un deplacement
//    arbitraire. On compte les essais : au bout de 40 essais et 8 secondes
//    sans un seul deplacement abouti, on abandonne le procede et la video
//    repasse en lecture en boucle. Le lecteur voit une video, jamais un trou.
//
// 3. LA VIDEO NE PESE PAS SUR LE PREMIER ECRAN. Elle n'est telechargee
//    qu'apres trois conditions reunies : un vrai geste de defilement, la
//    section proche de l'ecran, et le navigateur inoccupe. Qui ne descend pas
//    ne telecharge rien.
//
// 4. MOUVEMENT REDUIT ET ECONOMIE DE DONNEES. Dans les deux cas la section
//    devient une image fixe avec son texte. Rien ne bouge, rien ne se
//    telecharge, et le message reste entier.
//
// Les fichiers pointent vers alohapixel.com parce que c'est la demonstration.
// Qui installe le theme remplace les trois adresses ci-dessous par les
// siennes : c'est le seul endroit a changer.
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, useTranslations } from "@i18n";

interface Props {
  /** Paysage, densite standard. */
  src?: string;
  /** Paysage, ecrans a forte densite. */
  srcHd?: string;
  /** Portrait, telephones : une video paysage devrait etre agrandie 1,6x pour couvrir. */
  srcPortrait?: string;
  poster?: string;
  posterPortrait?: string;
  /** Portion de la video utilisee, en secondes. */
  from?: number;
  to?: number;
}

const {
  src = "https://alohapixel.com/wp-content/uploads/2026/08/ap-grotte-long-1920.mp4",
  srcHd = "https://alohapixel.com/wp-content/uploads/2026/08/ap-grotte-long-2560.mp4",
  srcPortrait = "https://alohapixel.com/wp-content/uploads/2026/08/ap-grotte-mobile.mp4",
  poster = "https://alohapixel.com/wp-content/uploads/2026/08/ap-grotte-poster.webp",
  posterPortrait = "https://alohapixel.com/wp-content/uploads/2026/08/ap-grotte-mobile-poster.webp",
  from = 0,
  to = 18,
}: Props = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

const title = t.home.aboutTitle;
const accent = t.home.aboutAccent;
const at = title.toLowerCase().indexOf(accent.toLowerCase());
const before = at >= 0 ? title.slice(0, at) : title;
const word = at >= 0 ? title.slice(at, at + accent.length) : "";
const after = at >= 0 ? title.slice(at + accent.length) : "";
---

<section
  class="film"
  data-film
  data-from={from}
  data-to={to}
  aria-labelledby="studio-title"
  data-slot="film-scene"
>
  <div class="film__pin">
    {/* La video est decorative : le texte pose par dessus porte tout le sens,
        et le decrire deux fois n'aiderait personne. */}
    <div class="film__media">
      <video
        class="film__video"
        playsinline
        muted
        preload="none"
        disablepictureinpicture
        aria-hidden="true"
        data-src={src}
        data-src-hd={srcHd}
        data-src-portrait={srcPortrait}
        data-poster={poster}
        data-poster-portrait={posterPortrait}></video>
    </div>

    {/* Voile de lecture. Deux couches : une horizontale qui protege la colonne
        de texte, une verticale qui rattache la scene au reste de la page. */}
    <div class="film__veil" aria-hidden="true"></div>
    {/* La lueur monte avec le carre de la progression : elle n'existe pas au
        debut, elle s'impose a la fin. C'est ce qui donne l'impression que la
        scene s'ouvre plutot qu'elle ne defile. */}
    <div class="film__bloom" aria-hidden="true"></div>

    <div class="film__content container-page">
      <div class="max-w-2xl">
        <p
          class="film__item flex items-center gap-3 text-xs font-medium tracking-[0.18em] text-white/80 uppercase"
        >
          <span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>
          {t.about.eyebrow}
        </p>

        <h2 id="studio-title" class="film__item font-display text-display-sm md:text-display-md mt-6 text-white">
          {
            word ? (
              <Fragment>
                {before}
                <span class="accent-script">{word}</span>
                {after}
              </Fragment>
            ) : (
              title
            )
          }
        </h2>

        <p class="film__item measure-wide mt-6 leading-relaxed text-white/85 md:text-lg">
          {t.home.aboutLede}
        </p>

        <div class="film__item mt-8 flex flex-wrap gap-3">
          <Button href={routes.about} variant="primary" size="md">
            {t.home.aboutCta}
            <Icon name="arrow-right" size={17} />
          </Button>
          <Button href={routes.contact} variant="outline" size="md">{t.nav.contact}</Button>
        </div>
      </div>
    </div>

    {/* Le rail dit ou on en est dans la sequence. Sans lui, un lecteur qui
        s'arrete au milieu ne sait pas s'il reste quelque chose a voir. */}
    <div class="film__rail" aria-hidden="true"><i></i></div>
  </div>
</section>

<style>
  /* La hauteur EST la duree. Trois hauteurs d'ecran donnent au lecteur de quoi
     derouler la sequence sans avoir a ramer, et laissent la marge necessaire
     au garde-fou de cadence (voir le commentaire en tete de fichier). */
  .film {
    position: relative;
    height: 300vh;
    background: var(--color-ink-950);
  }

  .film__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--color-ink-950);
  }

  /* inset negatif : la mise a l'echelle ne doit jamais laisser voir un bord. */
  .film__media {
    position: absolute;
    inset: -2%;
    transform: scale(1.06) translateZ(0);
    transform-origin: 52% 55%;
    will-change: transform;
    backface-visibility: hidden;
  }

  .film__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .film__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        color-mix(in oklab, var(--color-ink-950) 78%, transparent) 0%,
        color-mix(in oklab, var(--color-ink-950) 46%, transparent) 48%,
        transparent 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-ink-950) 46%, transparent) 0%,
        transparent 26%,
        transparent 68%,
        color-mix(in oklab, var(--color-ink-950) 58%, transparent) 100%
      );
  }

  .film__bloom {
    position: absolute;
    inset: 0;
    opacity: 0;
    mix-blend-mode: screen;
    background: radial-gradient(
      58% 62% at 62% 46%,
      color-mix(in oklab, var(--color-paper-50) 38%, transparent) 0%,
      color-mix(in oklab, var(--color-paper-50) 12%, transparent) 38%,
      transparent 72%
    );
  }

  .film__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .film__rail {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: color-mix(in oklab, var(--color-paper-50) 12%, transparent);
    z-index: 3;
  }

  .film__rail i {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(
      90deg,
      var(--color-coral-500) 0%,
      var(--color-reef-400) 62%,
      var(--color-paper-50) 100%
    );
    box-shadow: 0 0 0.85em color-mix(in oklab, var(--color-reef-400) 70%, transparent);
  }

  /* Repli. Sous 1025 pixels, en mouvement reduit ou en economie de donnees, la
     section cesse d'etre une sequence : elle redevient un bloc normal, haut
     d'un ecran, avec son image d'attente et son texte. Aucun morceau de
     message ne depend de l'animation, c'est la condition pour avoir le droit
     d'animer. */
  .film--flat {
    height: auto;
    min-height: 100svh;
  }

  .film--flat .film__pin {
    position: relative;
    height: auto;
    min-height: 100svh;
  }

  .film--flat .film__media {
    transform: none;
    inset: 0;
  }

  .film--flat .film__bloom {
    display: none;
  }

  .film--flat .film__rail {
    display: none;
  }

  .film--flat .film__content {
    position: relative;
    padding-block: 6rem;
  }

  .film--flat .film__veil {
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-ink-950) 66%, transparent) 0%,
      color-mix(in oklab, var(--color-ink-950) 34%, transparent) 42%,
      color-mix(in oklab, var(--color-ink-950) 62%, transparent) 100%
    );
  }

  /* Les elements de texte partent invisibles UNIQUEMENT quand le script est la
     pour les relacher. Sans cette classe posee par le script, un lecteur dont
     le JavaScript a echoue verrait une section vide : l'etat de depart est
     donc le lisible, et c'est le script qui prend la main. */
  .film--live .film__item {
    opacity: 0;
    will-change: opacity, transform;
  }
</style>

<script>
  // Voir le commentaire en tete de fichier pour le pourquoi de chaque garde-fou.
  const clamp = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);

  function setup(section: HTMLElement) {
    const video = section.querySelector<HTMLVideoElement>(".film__video");
    const media = section.querySelector<HTMLElement>(".film__media");
    const bloom = section.querySelector<HTMLElement>(".film__bloom");
    const bar = section.querySelector<HTMLElement>(".film__rail i");
    const items = [...section.querySelectorAll<HTMLElement>(".film__item")];
    if (!video || !media) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const wide = window.matchMedia("(min-width: 1025px)");
    const dense = window.matchMedia("(min-resolution: 1.5dppx)");

    const portrait = () => window.innerWidth <= 1024 && window.innerHeight >= window.innerWidth;

    // Economie de donnees demandee, ou reseau tres lent.
    const thrifty = () => {
      const c = (navigator as any).connection;
      if (!c) return false;
      return Boolean(c.saveData) || /^(slow-)?2g$/.test(c.effectiveType ?? "");
    };

    const animated = () => wide.matches && !reduce.matches && !thrifty();

    const from = Number(section.dataset.from ?? 0);
    const to = Number(section.dataset.to ?? 0);

    let loaded = false;
    let gesture = false;
    let near = false;
    let running = false;
    let raf = 0;
    let cursor = 0;
    let travel = 0;
    let last = "";
    let seekOk = false;
    let tries = 0;
    let firstTry = 0;
    let usePortrait = false;

    function poster() {
      const p = portrait()
        ? (video!.dataset.posterPortrait ?? video!.dataset.poster)
        : video!.dataset.poster;
      if (p && video!.getAttribute("poster") !== p) video!.setAttribute("poster", p);
    }

    function load() {
      if (loaded || !animated()) return;
      loaded = true;
      usePortrait = portrait() && Boolean(video!.dataset.srcPortrait);
      const chosen = usePortrait
        ? video!.dataset.srcPortrait!
        : dense.matches && video!.dataset.srcHd
          ? video!.dataset.srcHd
          : video!.dataset.src!;
      video!.preload = "auto";
      video!.src = chosen;
      video!.load();
      // Une premiere lecture immediatement mise en pause : c'est le seul moyen
      // fiable d'amorcer le decodeur sur les navigateurs mobiles, qui refusent
      // de se deplacer dans une video jamais lue.
      video!.addEventListener(
        "loadedmetadata",
        () => {
          const p = video!.play();
          if (p) p.then(() => { video!.pause(); try { video!.currentTime = 0.001; } catch {} }).catch(() => {});
        },
        { once: true },
      );
      video!.addEventListener("seeked", () => { seekOk = true; }, { once: true });
      video!.addEventListener(
        "error",
        () => {
          video!.style.display = "none";
          media!.style.backgroundImage = `url(${video!.getAttribute("poster") ?? ""})`;
          media!.style.backgroundSize = "cover";
          media!.style.backgroundPosition = "center";
        },
        { once: true },
      );
    }

    function tryLoad() {
      if (!gesture || !near || loaded || !animated()) return;
      const push = () =>
        "requestIdleCallback" in window
          ? (window as any).requestIdleCallback(load, { timeout: 2500 })
          : setTimeout(load, 200);
      if (document.readyState === "complete") push();
      else window.addEventListener("load", push, { once: true });
    }

    function progress() {
      const r = section.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      if (span > 40) return clamp(-r.top / span);
      return clamp((window.innerHeight - r.top) / (window.innerHeight + r.height));
    }

    function place(p: number) {
      items.forEach((el, n) => {
        const a = clamp((p - (0.06 + n * 0.055)) * 8);
        el.style.opacity = String(a);
        el.style.transform = `translate3d(0,${((1 - a) * 2.1).toFixed(3)}em,0)`;
      });
    }

    function release() {
      items.forEach((el) => { el.style.opacity = ""; el.style.transform = ""; });
      section.classList.remove("film--live");
    }

    function tick() {
      const p = progress();
      const key = p.toFixed(5);
      if (key !== last) {
        last = key;
        if (bar) bar.style.width = `${(p * 100).toFixed(2)}%`;
        media!.style.transform = `scale(${(1.06 - p * 0.055).toFixed(4)}) translateZ(0)`;
        if (bloom) bloom.style.opacity = (p * p * 0.85).toFixed(3);
        place(p);
      }

      const d = video!.duration;
      if (d && isFinite(d) && video!.readyState > 0 && !section.classList.contains("film--looping")) {
        const start = usePortrait ? 0 : from < d ? from : 0;
        let end = !usePortrait && to > start && to <= d ? to : d;
        // Garde-fou de cadence : au moins ~1,2 px de defilement par image.
        const most = travel / 36;
        if (end - start > most) end = start + most;

        const target = start + p * (end - start - 0.05);
        cursor += (target - cursor) * 0.2;

        if (!video!.seeking && Math.abs(video!.currentTime - cursor) > 0.015) {
          if (!firstTry) firstTry = performance.now();
          tries++;
          try { video!.currentTime = cursor; } catch {}
          // Le deplacement n'aboutit pas : on renonce et on lit en boucle.
          if (!seekOk && tries > 40 && performance.now() - firstTry > 8000 && p > 0.15) {
            section.classList.add("film--looping");
            video!.loop = true;
            video!.muted = true;
            video!.play()?.catch(() => {});
          }
        }
      }
      raf = requestAnimationFrame(tick);
    }

    const start = () => { if (!running && animated()) { running = true; raf = requestAnimationFrame(tick); } };
    const stop = () => { if (running) { running = false; cancelAnimationFrame(raf); } };

    function configure() {
      const live = animated();
      section.classList.toggle("film--flat", !live);
      section.classList.toggle("film--live", live);
      if (!loaded) poster();
      travel = section.offsetHeight - window.innerHeight > 40
        ? section.offsetHeight - window.innerHeight
        : window.innerHeight + section.offsetHeight;
      last = "";
      if (!live) { stop(); release(); return; }
      place(progress());
      tryLoad();
      start();
    }

    configure();

    (["wheel", "touchstart", "touchmove", "pointerdown", "keydown"] as const).forEach((e) =>
      window.addEventListener(e, () => { gesture = true; tryLoad(); }, { once: true, passive: true }),
    );

    if ("IntersectionObserver" in window) {
      new IntersectionObserver((es) => { if (es[0].isIntersecting) { near = true; tryLoad(); } },
        { rootMargin: "400px 0px" }).observe(section);
      new IntersectionObserver((es) => (es[0].isIntersecting ? start() : stop()),
        { rootMargin: "150px 0px" }).observe(section);
    } else { near = true; gesture = true; tryLoad(); start(); }

    let t = 0;
    window.addEventListener("resize", () => { clearTimeout(t); t = window.setTimeout(configure, 120); },
      { passive: true });
  }

  document.querySelectorAll<HTMLElement>("[data-film]").forEach(setup);
</script>

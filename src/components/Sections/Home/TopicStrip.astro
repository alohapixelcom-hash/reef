---
// src/components/Sections/Home/TopicStrip.astro - la bande des sujets : une carte par fil, avec le nombre de billets derriere chacun.
//
// Un sujet vide n'apparait pas. Une bande qui annonce cinq fils dont deux ne
// menent nulle part promet plus que le contenu ne tient, et c'est exactement la
// premiere chose qu'un utilisateur remarque quand il installe le theme avec ses
// propres billets.
import TopicCard from "@components/Cards/TopicCard.astro";
import SectionHeader from "@components/Sections/Global/SectionHeader.astro";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale, useTranslations } from "@i18n";
import { entrySlug } from "@i18n/content";
import type { CollectionEntry } from "astro:content";

type Props = {
  topics: CollectionEntry<"topics">[];
  /** Nombre de billets publies par slug de sujet, compte une fois par la page. */
  counts: Record<string, number>;
};

const { topics, counts } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

const filled = topics.filter((topic) => (counts[entrySlug(topic.id)] ?? 0) > 0);

// Trois cartes par rangee sur grand ecran, sur une grille de six colonnes. Ce
// qui depasse ne part PAS au centre : les dernieres cartes s'elargissent pour
// que chaque rangee soit pleine et calee a gauche.
//
// Une derniere rangee centree sous une rangee pleine est la signature d'une
// grille qu'on a laissee decider a notre place. Ici cinq sujets donnent une
// rangee de trois puis une rangee de deux qui occupent toute la largeur, et
// sept en donnent trois, deux, deux. Le cas d'une seule carte orpheline
// n'existe pas : quand il ne reste qu'une carte, les quatre dernieres se
// rangent en deux rangees de deux.
const rest = filled.length % 3;
const tail = rest === 0 ? 0 : rest === 2 ? 2 : Math.min(filled.length, 4);
const firstWide = filled.length - tail;
---

<section class="container-page py-16 md:py-24" aria-labelledby="topics-title" data-slot="topic-strip">
  {/* Titre a gauche, sortie vers l'index a droite, sur la meme ligne de base.
      Le bouton n'est pas sous la grille : la derniere rangee de sujets est
      pleine, et un bouton pose sous une rangee pleine flotte sans appui. */}
  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-10">
    <SectionHeader
      as="h2"
      headingId="topics-title"
      title={t.home.topicsTitle}
      accentWord={t.home.topicsAccent}
      lede={t.home.topicsLede}
      class="sm:flex-1"
    />
    <Button href={routes.topics} variant="ghost" size="md" class="shrink-0 self-start sm:self-auto">
      {t.home.topicsCta}
      <Icon name="arrow-right" size={17} />
    </Button>
  </div>

  <ul class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-6">
    {
      filled.map((topic, i) => {
        const slug = entrySlug(topic.id);
        return (
          <li class:list={["flex", i >= firstWide ? "lg:col-span-3" : "lg:col-span-2"]}>
            <TopicCard
              {topic}
              {locale}
              href={`${routes.topics}${slug}/`}
              count={counts[slug] ?? 0}
              class="w-full"
            />
          </li>
        );
      })
    }
  </ul>
</section>

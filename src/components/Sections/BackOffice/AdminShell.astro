---
// AdminShell.astro - socle visuel issu du back office SaaS alohapixel.app, modules adaptes au theme.
//
// Un back office est un outil plein ecran : il ne se monte JAMAIS sous la barre
// publique du site. Jusqu'a la 2.3.0 la coquille se poussait sous cette barre
// (une marge haute sur toute la section) et son rail n'etait ni colle ni borne :
// il commencait a 126 px du haut et sortait de l'ecran au premier defilement.
// Desormais le rail tient tout l'ecran sur grand ecran (colle, borne a un ecran
// de haut, defilement interne) et devient, sur telephone, une barre horizontale
// collee en haut. Le drapeau "compact" a disparu avec la marge qu'il compensait.
//
// Sous lg, <aside> et son enveloppe passent en display:contents : la tete, la
// navigation et le pied du rail deviennent des cases de la grille, ce qui
// permet a la navigation seule de rester collee sur toute la hauteur de la page
// (un element colle ne depasse jamais son parent).
import { Icon, type IconName } from "@components/svg/icons";
import { Breadcrumb } from "@components/ui/breadcrumb";
interface Props {
  brand: string; home: string; space: string; title: string; lede?: string; accentWord?: string;
  navigation: { href: string; label: string; icon: IconName }[];
  logout?: string; logoutUrl?: string; back?: string; connected?: string; login?: boolean;
  trail?: { label: string; href?: string }[]; contentTag?: "main" | "div"; skip?: string;
}
const { brand, home, space, title, lede, accentWord = "", navigation, logout = "", logoutUrl = "", back = "", connected = "", login = false, contentTag: Content = "main", skip = "" } = Astro.props;
const here = Astro.url.pathname;
const trail = Astro.props.trail ?? [{ label: brand, href: home }, { label: space, href: navigation[0]?.href }, { label: title }];
const at = accentWord ? title.toLowerCase().indexOf(accentWord.toLowerCase()) : -1;
const before = at >= 0 ? title.slice(0, at) : title;
const word = at >= 0 ? title.slice(at, at + accentWord.length) : "";
const after = at >= 0 ? title.slice(at + accentWord.length) : "";
const railLink = "flex min-h-11 shrink-0 items-center gap-2.5 rounded-2xl px-3 font-sans text-[0.95rem] whitespace-nowrap transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---
<section class="bg-muted/40 text-foreground" data-slot="admin-shell">
  {skip && <a href="#admin-main" class="bg-primary text-primary-foreground font-display sr-only rounded-pill px-5 py-3 text-sm font-bold focus-visible:not-sr-only focus-visible:fixed focus-visible:top-3 focus-visible:left-3 focus-visible:z-50">{skip}</a>}
  <div class="grid min-h-svh grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)]">
      <aside data-slot="admin-aside" class="dark text-foreground max-lg:contents lg:bg-background lg:min-w-0">
       <div class="max-lg:contents lg:sticky lg:top-0 lg:flex lg:h-svh lg:flex-col lg:overflow-y-auto">
        <div class="bg-background min-w-0 max-lg:order-1 [padding-top:max(0px,env(safe-area-inset-top))]">
          <a href={home} class="flex min-h-11 items-center gap-2 px-5 py-3 focus-visible:outline-2 focus-visible:outline-ring lg:py-5">
            <Icon name="wave" size={22} class="text-primary" />
            <span class="font-display text-lg font-extrabold tracking-tight">{brand}</span>
          </a>
          <p class="text-muted-foreground px-5 pb-4 text-xs font-semibold uppercase tracking-widest max-lg:hidden">{space}</p>
        </div>
        {!login && <nav aria-label={space} data-slot="admin-rail" class="bg-background min-w-0 px-3 pb-3 max-lg:sticky max-lg:top-0 max-lg:z-40 max-lg:order-2 max-lg:[padding-top:max(0.5rem,env(safe-area-inset-top))] lg:pb-4">
          <ul class="flex gap-1 overflow-x-auto lg:flex-col lg:overflow-visible">
            {navigation.map(item => <li>
              <a href={item.href} aria-current={here === item.href ? "page" : undefined}
                class={`${railLink} ${here === item.href ? "bg-muted font-semibold text-foreground" : "text-muted-foreground hover:bg-muted hover:text-foreground"}`}>
                <Icon name={item.icon} size={17} class="shrink-0" />{item.label}
              </a>
            </li>)}
          </ul>
        </nav>}
        <div class="bg-background min-w-0 px-5 max-lg:order-4 max-lg:pt-6"><slot name="rail" /></div>
        {(logout || back || Astro.slots.has("account")) && <div class="bg-background border-border min-w-0 border-t px-5 py-4 max-lg:order-5 lg:mt-auto lg:pb-6">
          <slot name="account" />
          {!login && logout && <>
            <p class="text-muted-foreground text-xs leading-relaxed">{connected}<br /><span data-session-email class="font-medium">&nbsp;</span></p>
            <button type="button" data-admin-logout={logoutUrl} class="border-border text-foreground rounded-pill mt-3 min-h-11 border px-4 text-sm font-semibold transition-colors duration-200 hover:bg-muted">{logout}</button>
          </>}
          {back && <a href={home} class="text-foreground hover:bg-muted rounded-pill mt-2 flex min-h-11 items-center gap-2 px-4 text-sm font-semibold transition-colors duration-200"><Icon name="arrow-left" size={16} class="shrink-0" />{back}</a>}
        </div>}
       </div>
      </aside>
      <Content id="admin-main" class="min-w-0 max-lg:order-3">
       <div class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-8 md:py-12">
        <Breadcrumb items={trail} label={space} />
        <header class="mt-6 flex flex-col gap-3">
          <h1 class="font-display text-3xl font-extrabold tracking-tight md:text-4xl text-foreground max-w-3xl">
            {word ? <Fragment>{before}<span class="accent-script">{word}</span>{after}</Fragment> : title}
          </h1>
          {lede && <p class="text-muted-foreground measure-wide leading-relaxed">{lede}</p>}
        </header>
        <div class="mt-8 flex flex-col gap-8"><slot /></div>
       </div>
      </Content>
  </div>
</section>

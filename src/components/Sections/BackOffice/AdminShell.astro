---
// AdminShell.astro - socle visuel issu du back office SaaS alohapixel.app, modules adaptes au theme.
import { Icon, type IconName } from "@components/svg/icons";
import { Breadcrumb } from "@components/ui/breadcrumb";
interface Props {
  brand: string; home: string; space: string; title: string; lede?: string; accentWord?: string;
  navigation: { href: string; label: string; icon: IconName }[];
  logout?: string; logoutUrl?: string; back?: string; connected?: string; login?: boolean;
  trail?: { label: string; href?: string }[]; contentTag?: "main" | "div"; compact?: boolean;
}
const { brand, home, space, title, lede, accentWord = "", navigation, logout = "", logoutUrl = "", back = "", connected = "", login = false, contentTag: Content = "main", compact = false } = Astro.props;
const here = Astro.url.pathname;
const trail = Astro.props.trail ?? [{ label: brand, href: home }, { label: space, href: navigation[0]?.href }, { label: title }];
const at = accentWord ? title.toLowerCase().indexOf(accentWord.toLowerCase()) : -1;
const before = at >= 0 ? title.slice(0, at) : title;
const word = at >= 0 ? title.slice(at, at + accentWord.length) : "";
const after = at >= 0 ? title.slice(at + accentWord.length) : "";
const railLink = "flex min-h-11 shrink-0 items-center gap-2.5 rounded-2xl px-3 font-sans text-[0.95rem] whitespace-nowrap transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---
<section class:list={["bg-muted/40 text-foreground", !compact && "pt-24 lg:pt-28"]} data-slot="admin-shell">
  <div class="flex min-h-svh flex-col lg:flex-row">
      <aside class="dark bg-background text-foreground flex min-w-0 flex-col lg:w-64 lg:shrink-0 [padding-top:max(0px,env(safe-area-inset-top))]">
        <a href={home} class="flex min-h-11 items-center gap-2 px-5 py-5 focus-visible:outline-2 focus-visible:outline-ring">
          <Icon name="wave" size={22} class="text-primary" />
          <span class="font-display text-lg font-extrabold tracking-tight">{brand}</span>
        </a>
        <p class="text-muted-foreground px-5 pb-4 text-xs font-semibold uppercase tracking-widest">{space}</p>
        {!login && <nav aria-label={space} data-slot="admin-rail" class="px-3 pb-4">
          <ul class="flex gap-1 overflow-x-auto lg:flex-col lg:overflow-visible">
            {navigation.map(item => <li>
              <a href={item.href} aria-current={here === item.href ? "page" : undefined}
                class={`${railLink} ${here === item.href ? "bg-muted font-semibold text-foreground" : "text-muted-foreground hover:bg-muted hover:text-foreground"}`}>
                <Icon name={item.icon} size={17} class="shrink-0" />{item.label}
              </a>
            </li>)}
          </ul>
        </nav>}
        <div class="px-5"><slot name="rail" /></div>
        {(logout || back || Astro.slots.has("account")) && <div class="border-border mt-4 border-t px-5 py-4 lg:mt-auto lg:pb-6">
          <slot name="account" />
          {!login && logout && <>
            <p class="text-muted-foreground text-xs leading-relaxed">{connected}<br /><span data-session-email class="font-medium">&nbsp;</span></p>
            <button type="button" data-admin-logout={logoutUrl} class="border-border text-foreground rounded-pill mt-3 min-h-11 border px-4 text-sm font-semibold transition-colors duration-200 hover:bg-muted">{logout}</button>
          </>}
          {back && <a href={home} class="text-muted-foreground hover:text-foreground mt-2 flex min-h-11 items-center px-4 text-sm font-semibold">{back}</a>}
        </div>}
      </aside>
      <Content class="min-w-0 flex-1">
       <div class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-8 md:py-12">
        <Breadcrumb items={trail} label={space} />
        <header class="mt-6 flex flex-col gap-3">
          <h1 class="font-display text-3xl font-extrabold tracking-tight md:text-4xl text-foreground max-w-3xl">
            {word ? <Fragment>{before}<span class="accent-script">{word}</span>{after}</Fragment> : title}
          </h1>
          {lede && <p class="text-muted-foreground measure-wide leading-relaxed">{lede}</p>}
        </header>
        <div class="mt-8 flex flex-col gap-8"><slot /></div>
       </div>
      </Content>
  </div>
</section>

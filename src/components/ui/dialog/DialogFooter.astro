---
// src/components/ui/dialog/DialogFooter.astro - pied du dialog : actions empilees sur mobile, alignees a droite des sm:.
// L'ordre s'inverse en colonne pour garder l'action principale au-dessus.
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

export const dialogFooter = tv({
  base: "mt-1 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end",
});

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div class={dialogFooter({ class: className })} data-slot="dialog-footer" {...rest}>
  <slot />
</div>

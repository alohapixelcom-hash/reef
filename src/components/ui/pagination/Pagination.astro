---
// src/components/ui/pagination/Pagination.astro - pagination en pilules : ses liens reutilisent la config tv() de Button, fenetre de pages avec ellipses.
// Les urls sortent de getUrl si fourni, sinon de basePath : la page 1 vit a
// basePath, les suivantes a basePath/2, basePath/3, etc. La page courante
// porte le corail (variant primary) et aria-current="page".
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";
import { button } from "../button";

export const pagination = tv({
  slots: {
    root: "flex w-full justify-center",
    list: "flex flex-wrap items-center justify-center gap-1.5",
    gap: "inline-flex size-11 items-center justify-center text-muted-foreground select-none",
  },
});

type Props = HTMLAttributes<"nav"> & {
  currentPage: number;
  totalPages: number;
  // Racine des urls, par exemple "/blog". Ignore si getUrl est fourni.
  basePath?: string;
  getUrl?: (page: number) => string;
  label?: string;
};

const {
  currentPage,
  totalPages,
  basePath = "",
  getUrl,
  label = "Pagination",
  class: className,
  ...rest
} = Astro.props;

const trimmed = basePath.replace(/\/+$/, "");
const toUrl = getUrl ?? ((page: number) => (page === 1 ? trimmed || "/" : `${trimmed}/${page}`));

// Fenetre compacte : premiere page, derniere page, la courante et ses deux
// voisines ; un trou d'exactement une page est comble plutot qu'ellipse.
function windowed(current: number, total: number): (number | "gap")[] {
  if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
  const anchors = [...new Set([1, current - 1, current, current + 1, total])]
    .filter((page) => page >= 1 && page <= total)
    .sort((a, b) => a - b);
  const out: (number | "gap")[] = [];
  let previous = 0;
  for (const page of anchors) {
    if (previous && page - previous === 2) out.push(previous + 1);
    else if (previous && page - previous > 2) out.push("gap");
    out.push(page);
    previous = page;
  }
  return out;
}

const pages = windowed(currentPage, totalPages);
const { root, list, gap } = pagination();
const arrow = button({ variant: "outline", size: "icon" });
const arrowDisabled = button({ variant: "outline", size: "icon", class: "pointer-events-none opacity-40" });
---

<nav class={root({ class: className })} data-slot="pagination" aria-label={label} {...rest}>
  <ul class={list()}>
    <li>
      {
        currentPage > 1 ? (
          <a class={arrow} href={toUrl(currentPage - 1)} rel="prev" aria-label="Previous page">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </a>
        ) : (
          <span class={arrowDisabled} aria-disabled="true">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </span>
        )
      }
    </li>
    {
      pages.map((page) =>
        page === "gap" ? (
          <li>
            <span class={gap()} aria-hidden="true">
              ...
            </span>
          </li>
        ) : (
          <li>
            <a
              class={button({ variant: page === currentPage ? "primary" : "ghost", size: "icon" })}
              href={toUrl(page)}
              aria-label={`Page ${page}`}
              aria-current={page === currentPage ? "page" : undefined}
            >
              {page}
            </a>
          </li>
        ),
      )
    }
    <li>
      {
        currentPage < totalPages ? (
          <a class={arrow} href={toUrl(currentPage + 1)} rel="next" aria-label="Next page">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </a>
        ) : (
          <span class={arrowDisabled} aria-disabled="true">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </span>
        )
      }
    </li>
  </ul>
</nav>

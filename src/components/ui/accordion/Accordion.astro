---
// src/components/ui/accordion/Accordion.astro - coquille de l'accordeon : empile des AccordionItem separes par un filet, sans aucun JavaScript.
// Pour l'ouverture exclusive (un seul volet a la fois), passer le meme name
// a chaque AccordionItem : c'est le comportement natif de <details name>.
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

export const accordion = tv({
  base: "w-full divide-y divide-border",
});

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div class={accordion({ class: className })} data-slot="accordion" {...rest}>
  <slot />
</div>

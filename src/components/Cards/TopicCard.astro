---
// src/components/Cards/TopicCard.astro - la carte d'un sujet : vague en filigrane, nom, description, nombre de billets, et l'accent declare par le contenu.
//
// L'accent d'un sujet est un NOM (coral, reef, ink), jamais une couleur : le
// contenu declare une intention, la table topicTone la traduit en tokens. C'est
// ce qui permet de repeindre le theme sans rouvrir un seul fichier de contenu.
//
// Pourquoi une vague en filigrane, et plus une initiale geante
// ------------------------------------------------------------
// Un sujet doit se reconnaitre AVANT d'etre lu : cinq cartes de texte cote a
// cote ne donnent que cinq rectangles gris. Il faut donc une silhouette par
// carte.
//
// La premiere reponse etait l'initiale du sujet, posee tres grande en fond.
// Elle a ete retiree, et la raison merite d'etre ecrite pour qu'on ne la
// repose pas : la lettre geante en filigrane est un tic visuel que le public
// associe aux pages generees. Le reproche est arrive de l'exterieur, sur la
// vignette d'un billet, et il valait pour toutes les cartes du theme.
//
// La vague le remplace, et ce n'est pas un motif de substitution choisi au
// hasard : le logo de la maison EST une vague, et c'est deja elle qui souligne
// le mot d'accent des grands titres. La carte porte donc la signature de la
// marque plutot qu'une lettre que n'importe quel theme pourrait poser. Elle
// prend la couleur du sujet, elle deborde du coin, et elle se lit a toutes les
// densites parce que c'est un trace, pas une image.
import { Icon } from "@components/svg/icons";
import { fmt, useTranslations, type Locale } from "@i18n";
import type { CollectionEntry } from "astro:content";
import { topicTone } from "./topicTone";

// Re-export de commodite : la table canonique vit dans ./topicTone, et les
// composants qui montrent un sujet peuvent la prendre ici ou la, au choix.
export { topicTone };

type Props = {
  topic: CollectionEntry<"topics">;
  href: string;
  /** Nombre de billets publies dans ce sujet, deja compte par la page. */
  count: number;
  locale: Locale;
  /** Niveau de titre reel, selon ce qui precede la grille dans la page. */
  as?: "h2" | "h3";
  class?: string;
};

const { topic, href, count, locale, as: Tag = "h3", class: className }: Props = Astro.props;
const t = useTranslations(locale);
const tone = topicTone[topic.data.accent];
const countLabel = count === 1 ? t.topics.countOne : fmt(t.topics.countLabel, { count });
---

<article
  class:list={[
    "group border-border bg-card rounded-card relative flex flex-col gap-3 overflow-hidden border p-7",
    "transition-[border-color,transform,box-shadow] duration-300",
    "hover:shadow-float hover:-translate-y-0.5",
    tone.hover,
    className,
  ]}
  data-slot="topic-card"
>
  {/* La vague deborde des deux bords en bas : entierement contenue elle aurait
      l'air d'un logo pose dans un coin, coupee elle a l'air d'un fond sur
      lequel le texte est imprime. */}
  <svg
    class:list={[
      "pointer-events-none absolute -right-6 -bottom-4 -left-6 w-[calc(100%+3rem)] select-none",
      "opacity-[0.16] transition-opacity duration-300 group-hover:opacity-30",
      tone.ghost,
    ]}
    viewBox="0 0 200 60"
    fill="none"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0 34c20-16 40-16 60 0s40 16 60 0 40-16 60 0 40 16 60 0"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"></path>
    <path
      d="M0 48c20-12 40-12 60 0s40 12 60 0 40-12 60 0 40 12 60 0"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>

  <span class:list={["relative h-0.5 w-10 rounded-pill", tone.rule]} aria-hidden="true"></span>

  <Tag class="font-display text-foreground relative text-xl font-bold tracking-tight">
    {/* Le lien couvre toute la carte via ::after : un seul arret de tabulation,
        et pourtant la surface cliquable est celle que le doigt vise. */}
    <a href={href} class="after:absolute after:inset-0 after:content-['']">
      {topic.data.name}
    </a>
  </Tag>

  {/* La description garde sa mesure meme quand la carte s'elargit. Sur une
      carte de deux tiers de page, une description qui va d'un bord a l'autre
      donne des lignes de cent trente signes : plus personne ne les lit, et la
      carte cesse d'etre une carte pour devenir un paragraphe encadre. */}
  <p class="text-muted-foreground relative line-clamp-4 max-w-[62ch] text-[0.95rem] leading-relaxed">
    {topic.data.description}
  </p>

  <p class="relative mt-auto flex items-center gap-2 pt-2">
    <span class:list={["rounded-pill px-2.5 py-1 text-xs font-medium", tone.chip]}>
      {countLabel}
    </span>
    <span
      class="text-muted-foreground group-hover:text-foreground ml-auto transition-colors duration-200"
      aria-hidden="true"
    >
      <Icon name="arrow-right" size={18} />
    </span>
  </p>
</article>

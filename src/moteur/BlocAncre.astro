---
// src/moteur/BlocAncre.astro - un bloc de texte riche ; les intertitres portent l'ancre calculee par corpsDuBillet.
//
// Le bloc d'origine du moteur ajoute a chaque paragraphe des classes
// d'alignement. La colonne de lecture du theme n'en veut pas : un billet saisi
// dans le back office sort au meme balisage que le meme billet ecrit en Markdown.
interface Props {
  node: { style?: string; ancre?: string };
}
const { node } = Astro.props;
const style = node.style ?? "normal";
const Balise = (/^h[1-6]$/.test(style) ? style : style === "blockquote" ? "blockquote" : "p") as "p";
---

<Balise id={node.ancre}><slot /></Balise>

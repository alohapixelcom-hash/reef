---
// src/moteur/PageLibre.astro - une page libre du back office (collection "pages") : le cadre du site, un bandeau de tete, une photo, le texte, et son SEO.
//
// Rendue par [...locale]/index.astro quand l'adresse est celle d'une page
// libre (src/moteur/pages.ts), a la demande, moteur allume seulement. Elle
// reprend les pieces des pages annexes (bandeau PageHero, colonne .prose) et
// n'a aucune classe a elle, seulement des classes que le theme emploie deja :
// ce fichier est hors du scan de Tailwind (src/styles/global.css), et le build
// statique ne doit pas bouger d'un octet.
//
// SEO : le panneau SEO de l'entree passe avant ses champs, qui passent avant
// les valeurs du site. Un noindex la retire aussi du plan du site.
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import TexteRiche from "@moteur/texte-riche";
import { annotationDe, type AnnotationsDeLEntree, estEditable, SANS_ANNOTATION } from "./annotations";
import { media } from "./cadre";
import PhotoDuMoteur from "./PhotoDuMoteur.astro";
import type { PageLibre } from "@moteur/cadre-base";

interface Props {
  page: PageLibre;
}

const { page } = Astro.props;
const data = page.data;
const texte = (valeur: unknown): string | undefined => (typeof valeur === "string" && valeur.trim() !== "" ? valeur.trim() : undefined);
const seo = data.seo ?? {};
const titre = texte(data.title) ?? page.slug;
const photo = media(data.image);
const imageSeo = texte(seo.image as string | undefined);
const image = imageSeo
  ? { src: imageSeo.startsWith("/") || /^https?:/.test(imageSeo) ? imageSeo : `/_emdash/api/media/file/${imageSeo}`, alt: titre }
  : photo?.src
    ? { src: photo.src, alt: photo.alt ?? "" }
    : undefined;
// La barre d'edition : l'entree sur le bandeau, titre et introduction dans la
// page. Le texte (Portable Text) s'edite seul, par l'editeur integre d'EmDash.
const edition: AnnotationsDeLEntree = estEditable(page.edit)
  ? { entree: annotationDe(page.edit), champ: (nom) => annotationDe(page.edit, nom) }
  : SANS_ANNOTATION;
const corps = Array.isArray(data.body) && data.body.length > 0 ? data.body : null;
---

<BaseLayout
  title={texte(seo.title) ?? titre}
  description={texte(seo.description) ?? texte(data.lede)}
  image={image}
  canonical={texte(seo.canonical)}
  noindex={seo.noIndex === true}
>
  <Navbar />

  <main id="content">
    <PageHero title={titre} lede={texte(data.lede)} crumbs={[{ label: titre }]} edition={edition} />
    {
      (photo || edition.champ("image")["data-emdash-ref"]) && (
        <div class="container-page" style="margin-top:2.5rem" {...edition.champ("image")}>
          {photo && <PhotoDuMoteur media={photo} class="rounded-card w-full" widths={[720, 1200, 1440, 1920]} sizes="100vw" alt={photo.alt ?? ""} />}
        </div>
      )
    }
    <div class="container-page" style="padding-block:clamp(3.5rem, 8vw, 5rem)">
      <div class="prose">{corps && <TexteRiche value={corps} />}</div>
    </div>
  </main>

  <Footer />
</BaseLayout>

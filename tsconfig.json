{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "src/components/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@layouts/*": [
        "src/layouts/*"
      ],
      "@styles/*": [
        "src/styles/*"
      ],
      "@js/*": [
        "src/js/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@i18n": [
        "src/i18n/index.ts"
      ],
      "@i18n/*": [
        "src/i18n/*"
      ],
      "@moteur/source": [
        "src/moteur/source.fichiers.ts"
      ],
      "@moteur/TexteRiche.astro": [
        "src/moteur/TexteRiche.emdash.astro"
      ],
      "@moteur/live": [
        "src/moteur/live.fichiers.ts"
      ],
      "@moteur/texte-riche": [
        "src/moteur/texte-riche.fichiers.astro"
      ],
      "@moteur/cadre-base": [
        "src/moteur/cadre.fichiers.ts"
      ],
      "@moteur/courriels": [
        "src/moteur/extensions/courriels/formulaire.fichiers.ts"
      ],
      "@moteur/catalogue-emdash": [
        "src/moteur/catalogue-emdash.d.ts"
      ],
      "@moteur/*": [
        "src/moteur/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ]
}

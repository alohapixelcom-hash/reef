{
  "name": "reef-backoffice-preview",
  "account_id": "d3da492833dae43a225de4e482af06db",
  "main": "preview-worker.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "vars": {
    "ALOHA_AUTH_ORIGIN": "https://alohapixel.app",
    "ALOHA_ADMIN_EMAILS": "contact@alohapixel.com",
    "ALOHA_EDITORIAL_CONFIG": "{\"id\": \"reef\", \"depot\": \"alohapixelcom-hash/reef\", \"branche\": \"codex/backoffice-aloha-2-3\", \"dossierArticles\": \"src/data/posts\", \"dossierAuteurs\": \"src/data/authors\", \"dossierSujets\": \"src/data/topics\", \"dossierImages\": \"src/assets/covers\", \"fichierImages\": \"scripts/covers.json\", \"format\": \"reef\", \"langues\": [\"fr\", \"en\"]}"
  },
  "services": [
    {
      "binding": "ALOHA_AUTH",
      "service": "aloha-store"
    },
    {
      "binding": "ALOHA_CONTENT",
      "service": "aloha-store"
    }
  ],
  "routes": [
    {
      "pattern": "reef-preview.alohapixel.app",
      "custom_domain": true
    }
  ]
}

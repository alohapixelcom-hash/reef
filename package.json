{
  "name": "reef",
  "type": "module",
  "version": "1.5.3",
  "description": "Reef, a free bilingual Astro 7 blog theme by Aloha Pixel. Reading-first typography, MDX collections, art-directed light and dark modes, owned SEO, Capacitor-ready.",
  "license": "MIT",
  "author": "Aloha Pixel (https://alohapixel.app)",
  "homepage": "https://reef.alohapixel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alohapixelcom-hash/reef.git"
  },
  "bugs": {
    "url": "https://github.com/alohapixelcom-hash/reef/issues"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "blog-theme",
    "tailwindcss",
    "mdx",
    "i18n",
    "capacitor"
  ],
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "app": "astro build && node scripts/app.mjs",
    "build": "node scripts/covers.mjs && astro build",
    "check": "astro check",
    "covers": "node scripts/covers.mjs",
    "dev": "astro dev",
    "og": "node scripts/og.mjs",
    "preview": "astro preview",
    "rebrand": "node scripts/rebrand.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0"
  }
}

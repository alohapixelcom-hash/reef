# .env.example - environment template for the contact action, which ships unmounted.
#
# The theme builds 100% static: nothing below is required to run, build or
# deploy it. These variables only matter once you mount the server half of the
# contact form. The four activation steps (adapter, src/actions/index.ts,
# these variables, the client call) are documented at the top of
# src/actions/contact.ts.
#
# To use: copy this file to .env, uncomment the lines and fill them in.
# .env is gitignored; keep it that way.

# Resend API key, created at https://resend.com (starts with re_).
# Read by src/actions/contact.ts as import.meta.env.RESEND_API_KEY.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact form messages.
# CONTACT_TO=you@yourdomain.com

# Sender identity, verified on your Resend account.
# CONTACT_FROM=Lagoon <hello@yourdomain.com>

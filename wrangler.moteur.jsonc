// wrangler.moteur.jsonc - le Worker de Reef quand le moteur de publication est allume.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reef-moteur",
  "main": "./src/worker.moteur.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "reef-moteur" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "reef-moteur-media" }],
  // Les pages introuvables figees (404.html, fr/404.html) sont des fichiers :
  // demandees par leur propre adresse, les assets les serviraient en 200 sans
  // reveiller le Worker. Cette liste les lui confie, et il repond 404 (voir
  // src/worker-adresses.ts).
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/404", "/404/", "/404.html", "/fr/404", "/fr/404/", "/fr/404.html"]
  },
  // Optimise a la demande les images des pages gerees (voir moteur.config.mjs).
  "images": { "binding": "IMAGES" },
  // Les courriels du site (formulaire de contact, essais, renvois) : la
  // liaison Cloudflare Email Sending, que l'extension Courriels du back office
  // utilise (src/moteur/extensions/courriels/). Sans elle, rien ne part.
  "send_email": [{ "name": "EMAIL" }],
  // Publication programmee et entretien : une minute de resolution.
  "triggers": { "crons": ["* * * * *"] }
}
